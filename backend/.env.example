# Backend Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env* files to version control.

# ── MongoDB Configuration ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://cluster.mongodb.net/brighterbank?retryWrites=true&w=majority&tls=true
MONGODB_FIELD_ENCRYPTION_KEY=
MONGODB_ENCRYPTION_SALT=

# ── JWT Configuration ──────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security Settings ─────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30m
SESSION_TIMEOUT=15m

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS Settings (comma-separated) ──────────────────────────────────────────────
# Vercel URL + any custom domains
ALLOWED_ORIGINS=https://brighter-bank.vercel.app

# ── Feature Flags ──────────────────────────────────────────────────────────────
FEATURE_MERCHANT_SERVICES=false

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=365